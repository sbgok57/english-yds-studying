# ============================================================
# YDS EXAM — Ortam değişkeni şablonu (tüm modüller)
# Bu dosya commit'lenebilir (secret İÇERMEZ). Kopyası .env.local
# adıyla oluşturulur ve .gitignore'dadır.
# Production'da değerleri Vercel ⇄ Supabase Integration otomatik basar;
# burası yalnız yerel geliştirme içindir.
# ============================================================

# ── Supabase (Modül 1-3; Vercel'de integration otomatik basar) ──
NEXT_PUBLIC_SUPABASE_URL=https://<PROJE_REF>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # ⚠️ YALNIZ sunucu tarafı; asla NEXT_PUBLIC_ yapma
SUPABASE_PROJECT_REF=<PROJE_REF>    # config-patch scripti için
SUPABASE_ACCESS_TOKEN=              # Management API; yerel scriptlerde, deploy'da GitHub Secrets'ta

# ── Modül 2: Push bildirimleri ──
VAPID_PUBLIC_KEY=                   # npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=                  # ⚠️ asla NEXT_PUBLIC_ yapma
NEXT_PUBLIC_VAPID_PUBLIC_KEY=       # public olanın aynısı
VAPID_CONTACT_EMAIL=destek@seninsiten.com
CRON_SECRET=                        # uzun rastgele dizi (üret: openssl rand -hex 32)

# ── Modül 3: Sesli gramer ──
NEXT_PUBLIC_AUDIO_BASE_URL=/audio   # üretimde: .../storage/v1/object/public/grammar-audio
OPENAI_API_KEY=                     # yalnız yerel TTS üretimi; deploy'a GİRMEZ
ELEVENLABS_API_KEY=                 # (alternatif sağlayıcı)
ELEVENLABS_VOICE_ID=
ELEVENLABS_TR_EMEL_VOICE_ID=        # ayrı Türkçe kadın anlatıcı ID'si
ELEVENLABS_TR_AHMET_VOICE_ID=       # ayrı Türkçe erkek anlatıcı ID'si; Emel ID'sinden farklı olmalı

# ── Kelime görselleri (yalnız sunucu tarafı; üretim istekleri sağlayıcı kredisi kullanabilir) ──
POLLINATIONS_API_KEY=                # gen.pollinations.ai secret key; istemciye/NEXT_PUBLIC_ önekine koyma

# ── Doğrulanmış konuşmacı profilleri için Azure Speech (yalnız sunucu tarafı) ──
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# ── Site ──
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── GitHub Actions (buraya YAZMA; repo Settings → Secrets'a eklenir) ──
# SUPABASE_ACCESS_TOKEN, SUPABASE_DB_PASSWORD
