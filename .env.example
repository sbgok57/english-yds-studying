# ==========================================
# YDS MASTER — VERCEL & PRODUCTION ENV CONFIG
# ==========================================

# 1. Database (Optional)
# Varsayılan olarak proje içindeki hazır SQLite veritabanı kullanılır (Vercel serverless ortamında otomatik /tmp/dev.db'ye kopyalanır).
# Kalıcı bulut veritabanı kullanmak isterseniz (Supabase / Neon / Vercel Postgres) aşağıdaki satırı açabilirsiniz:
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# 2. Kimlik Doğrulama Güvenlik Anahtarları (Zorunlu)
# Vercel Environment Variables kısmına ekleyin:
AUTH_SECRET="yds-mastery-production-secure-key-2026-supersecret"
NEXTAUTH_SECRET="yds-mastery-production-secure-key-2026-supersecret"

# 3. Yayın Alan Adı (Vercel domaininiz oluştuktan sonra güncelleyebilirsiniz)
NEXTAUTH_URL="https://english-yds-studying.vercel.app"

# 4. Opsiyonel Servisler (Girilmese de sistem sorunsuz çalışır)
# E-posta doğrulama için Resend veya SMTP (Opsiyonel):
# RESEND_API_KEY=""
# RESEND_FROM="YDS Master <onboarding@resend.dev>"

# Harici Stüdyo TTS ve Görseller (Opsiyonel - girilmezse dahili Microsoft TTS ve Web Speech API çalışır):
# AZURE_SPEECH_KEY=""
# AZURE_SPEECH_REGION="westeurope"
# UNSPLASH_ACCESS_KEY=""
