{
  "name": "yds-master",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "postinstall": "node prisma/prepare-db.js && prisma generate",
    "build": "node prisma/prepare-db.js && prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "zero-error": "node scripts/zero-error-check.mjs",
    "test": "node prisma/prepare-db.js && prisma generate && npm run test:unit && npm run test:integration",
    "test:unit": "tsx test/site-integrity-tests.ts && tsx test/tts-unit-tests.ts && tsx test/hardware-and-resilience-tests.ts && tsx test/auth-unit-tests.ts && tsx test/unit-tests.ts && tsx test/adaptive-unit-tests.ts && tsx test/error-shield-tests.ts",
    "test:integration": "tsx test/tts-integration-tests.ts && tsx test/auth-integration-tests.ts && tsx test/module-tests.ts",
    "test:e2e": "tsx test/e2e-tests.ts",
    "validate:data": "tsx test/validate-data.ts",
    "verify": "npm run typecheck && npm run zero-error && npm run lint && npm run validate:data && npm run test:unit && npm run test:integration && npm run build",
    "prisma:generate": "node prisma/prepare-db.js && prisma generate",
    "prisma:push": "node prisma/prepare-db.js && prisma db push",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@react-three/drei": "^9.114.0",
    "@react-three/fiber": "^8.17.10",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "bcryptjs": "^2.4.3",
    "canvas-confetti": "^1.9.3",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.17",
    "lottie-react": "^2.4.0",
    "lucide-react": "^0.460.0",
    "msedge-tts": "^2.0.7",
    "next": "14.2.18",
    "nodemailer": "^10.0.9",
    "pdfjs-dist": "^4.8.69",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.5.4",
    "tesseract.js": "^5.1.1",
    "three": "^0.169.0",
    "web-push": "^3.6.7",
    "zod": "^3.23.8",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20.17.6",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.63.0",
    "postcss": "^8.4.47",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
