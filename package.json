{
  "name": "ydt-yds-english-mastery",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "./node_modules/.bin/vite",
    "build": "./node_modules/.bin/tsc && ./node_modules/.bin/vite build",
    "preview": "./node_modules/.bin/vite preview",
    "typecheck": "./node_modules/.bin/tsc --noEmit",
    "lint": "./node_modules/.bin/eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "validate:content": "./node_modules/.bin/tsx scripts/validate-content.ts",
    "validate:vocabulary": "./node_modules/.bin/tsx scripts/validate-vocabulary-content.ts",
    "validate:grammar": "./node_modules/.bin/tsx scripts/validate-grammar-content.ts",
    "validate": "npm run validate:vocabulary && npm run validate:content && npm run validate:grammar",
    "test": "./node_modules/.bin/tsx scripts/run-tests.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.395.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.13.1",
    "@typescript-eslint/parser": "^7.13.1",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.15.6",
    "typescript": "^5.5.2",
    "vite": "^5.3.1"
  }
}
