# PostgreSQL bağlantısı
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/yds_words?schema=public"

# Anthropic Console'dan alınan gizli anahtar. Sadece sunucuda tutulmalı.
ANTHROPIC_API_KEY=""
# Varsayılan model; hesabınızda erişilebilir bir model ID'siyle değiştirilebilir.
CLAUDE_MODEL="claude-sonnet-5"

PORT=3000
NODE_ENV="development"
# Yalnızca development ortamında, giriş sistemi bağlanana kadar kullanılır.
DEV_USER_ID="local-dev-user"

# Admin backfill rotası için en az 32 karakterlik rastgele bir sır kullanın.
ADMIN_API_KEY="change-this-to-a-random-secret-at-least-32-characters-long"

# Gerekirse virgülle ayrılmış, tam origin değerleri: https://yds.example.com,https://admin.example.com
# Aynı origin'de çalışan web arayüzü için boş bırakılabilir.
CORS_ORIGINS=""

WORKER_POLL_MS=1000
MAX_ATTEMPTS=5
