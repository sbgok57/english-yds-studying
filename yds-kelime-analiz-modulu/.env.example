# PostgreSQL bağlantısı
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/yds_words?schema=public"

# Anthropic Console'dan alınan gizli anahtar. Sadece sunucuda tutulmalı.
ANTHROPIC_API_KEY=""
CLAUDE_MODEL="claude-sonnet-5"

PORT=3000
NODE_ENV="development"

# Geliştirme ortamında kullanıcı kimliğini taklit etmek içindir; production'da kullanılmaz.
DEV_USER_ID="local-dev-user"
# Tek sahip hesabının mevcut kimlik doğrulama sağlayıcısındaki sabit kullanıcı ID'si.
# Geliştirmede DEV_USER_ID ile aynı bırakılabilir. Production'da kendi Auth UID'nizi girin.
OWNER_USER_ID="local-dev-user"

# Aynı origin'deki site için boş bırakılabilir.
# Farklı origin kullanıyorsanız virgülle tam origin'leri yazın.
CORS_ORIGINS=""

WORKER_POLL_MS=1000
MAX_ATTEMPTS=5

# FSRS: varsayılan hedef hatırlama olasılığı ve 24 saatte gösterilecek yeni kelime sayısı.
FSRS_RETENTION=0.90
DAILY_NEW_CARD_LIMIT=20
