generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Word {
  id               String    @id @default(cuid())
  userId           String    @db.VarChar(128)
  term             String    @db.VarChar(100)
  context          String?   @db.VarChar(500)
  lemma            String?   @db.VarChar(120)
  cefrLevel        String?   @db.VarChar(12)
  confidence       String?   @db.VarChar(12)
  analysis         Json?
  enrichmentStatus String    @default("PENDING") @db.VarChar(16)
  attempts         Int       @default(0)
  nextAttemptAt    DateTime  @default(now())
  lastError        String?   @db.VarChar(1000)
  analyzedModel    String?   @db.VarChar(100)
  analyzedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([enrichmentStatus, nextAttemptAt, createdAt])
  @@index([enrichmentStatus, updatedAt, attempts])
  @@index([userId, createdAt])
  @@index([userId, term])
}
